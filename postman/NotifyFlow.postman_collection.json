{
  "info": {
    "name": "NotifyFlow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Create notification",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipient\": \"customer@example.com\",\n  \"message\": \"Your order #1052 has been confirmed.\",\n  \"channel\": \"EMAIL\"\n}"
        }
      }
    },
    {
      "name": "2. Create with Idempotency-Key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "order-1052-confirmation"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipient\": \"customer@example.com\",\n  \"message\": \"Your order #1052 has been confirmed.\",\n  \"channel\": \"EMAIL\"\n}"
        }
      }
    },
    {
      "name": "3. Create notification that always fails",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipient\": \"customer@example.com\",\n  \"message\": \"[fail] test retries\",\n  \"channel\": \"EMAIL\"\n}"
        }
      }
    },
    {
      "name": "4. Get all",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notifications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications"
          ]
        }
      }
    },
    {
      "name": "5. Get by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notifications/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications",
            "1"
          ]
        }
      }
    },
    {
      "name": "6. Filter by status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notifications/status/PENDING",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications",
            "status",
            "PENDING"
          ]
        }
      }
    },
    {
      "name": "7. Update (only while PENDING)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipient\": \"customer@example.com\",\n  \"message\": \"Updated message\",\n  \"channel\": \"EMAIL\"\n}"
        }
      }
    },
    {
      "name": "8. Delivery history (attempts)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notifications/1/attempts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications",
            "1",
            "attempts"
          ]
        }
      }
    },
    {
      "name": "9. Retry a FAILED notification",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notifications/3/retry",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications",
            "3",
            "retry"
          ]
        }
      }
    },
    {
      "name": "10. Delete",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notifications/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications",
            "1"
          ]
        }
      }
    },
    {
      "name": "11. Invalid body (expect 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notifications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recipient\": \"\",\n  \"message\": \"\",\n  \"channel\": \"EMAIL\"\n}"
        }
      }
    },
    {
      "name": "12. Not found (expect 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notifications/99999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications",
            "99999"
          ]
        }
      }
    }
  ]
}